# ---------------------------------------------------------------
# LAST CALL — Git attributes (Unity 6.6, Force Text serialization)
# ---------------------------------------------------------------
* text=auto

# --- Code & config (text) ---
*.cs        text diff=csharp
*.asmdef    text
*.asmref    text
*.json      text
*.md        text
*.yml       text
*.yaml      text
*.xml       text
*.shader    text
*.hlsl      text
*.cginc     text
*.compute   text
*.uss       text
*.uxml      text
*.inputactions text
*.shadergraph  text
*.shadersubgraph text
*.vfx       text

# --- Unity YAML (text, smart merge) ---
# Configure once per machine (see README):
#   git config merge.unityyamlmerge.name "Unity SmartMerge"
#   git config merge.unityyamlmerge.driver "'<UnityEditor>/Data/Tools/UnityYAMLMerge.exe' merge -p %O %B %A %A"
